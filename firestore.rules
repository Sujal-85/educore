rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (required, 'student' or 'teacher')
    //   - behaviorScore: number
    //   ... other fields
    //
    // Collection: behaviorIncidents
    // Fields:
    //   - studentId: string (required)
    //   - type: string (required, 'Positive' or 'Negative')
    //   - description: string (required)
    //   - scoreChange: number (required)
    //   - createdAt: string (required)
    //
    // Collection: notifications
    // Fields:
    //   - userId: string (required)
    //   - title: string (required)
    //   - message: string (required)
    //   - read: bool
    //   - createdAt: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'teacher' || getUserData().role == 'Teacher' || getUserData().role == 'TEACHER'));
    }

    function isStudent() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'student' || getUserData().role == 'Student' || getUserData().role == 'STUDENT'));
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (getUserData().role == 'admin' || getUserData().role == 'Admin' || getUserData().role == 'ADMIN')) ||
          (request.auth.token.email == "khedekarsujay720@gmail.com" && request.auth.token.email_verified == true)); // Default admin
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isTeacher() || isOwner(userId) || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }

    match /behaviorIncidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isTeacher() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isTeacher() || isAdmin());
      allow create: if isAuthenticated(); // Teachers or system can create
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isTeacher() || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isTeacher() || isAdmin());
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /studyPlans/{planId} {
      allow read: if isAuthenticated() && (isTeacher() || request.auth.uid == resource.data.studentId || isAdmin());
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /feePayments/{paymentId} {
      allow read: if isAuthenticated() && (isTeacher() || request.auth.uid == resource.data.studentId || isAdmin());
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /timetable/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }
  }
}
